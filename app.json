{
  "expo": {
    "name": "RiftValley Osmotics",
    "slug": "aquasystem",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/lg.png",
    "scheme": "Riftvalleyosmotics",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/lg.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/lg.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.RiftvalleyOsmotics.rvo"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "@clerk/expo",
      "expo-secure-store",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "590902ef-2380-4763-84c4-f7c683c853c6"
      }
    }
  }
}
